# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Database: use the Supabase Transaction pooler connection string for asyncpg.
# Replace PROJECT_REF and DB_PASSWORD; URL-encode reserved password characters.
# Do not use the Supabase anon key or service-role key as DB_PASSWORD.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:DB_PASSWORD@aws-1-region.pooler.supabase.com:6543/postgres

# App
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-64-char-string
APP_NAME=FasalSetu API
APP_VERSION=1.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Open-Meteo (no key needed, just the base URL)
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1
